# PostgreSQL (SQLAlchemy URL)
# Match POSTGRES_HOST_PORT in docker-compose (default 5431). From host -> container 5432:
POSTGRES_HOST_PORT=5431
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5431/scheduling
# API in Docker uses DATABASE_URL from docker-compose (postgres:5432 on the compose network).

# When true, rooms/lessons/instructors load from app/mock_data/*.csv (see lessons_data.py + scripts/export_mock_csvs.py).
# Default: false to fetch lessons/rooms/instructors from microservices.
USE_MOCK_DATA=false

# External microservices (no trailing slash on host; Location includes /api/v1 — see below)
# Gateway-style root (no trailing slash). Scheduling calls GET/POST …/api/admin/… under this path.
ATTENDANCE_BASE_URL=https://myada.site/attendance
# JWT for Attendance (raw token or already prefixed with "Bearer "). Scheduling API stays unauthenticated.
ATTENDANCE_ACCESS_TOKEN=
# LocationService: full URL through /api/v1 (scheduling calls GET {LOCATION_BASE_URL}/rooms).
# Deployed gateway (example): /location is the gateway segment; service sees /api/v1/... behind it.
LOCATION_BASE_URL=https://myada.site/location/api/v1
# Local direct LocationService (no gateway): http://localhost:5005/api/v1
# Auth host (or gateway root). Paths are always /api/auth/... from this host.
AUTH_BASE_URL=https://myada.site
# Admin Bearer token for server-side GET /api/auth/users-by-role/Instructor (required when USE_MOCK_DATA=false)
AUTH_SERVICE_ACCESS_TOKEN=

HTTP_TIMEOUT_SECONDS=30

# Logging: console + daily rotating file under LOG_DIR (default logs/scheduling.txt); keep LOG_BACKUP_COUNT days
LOG_DIR=logs
LOG_FILENAME=scheduling.txt
LOG_LEVEL=INFO
LOG_BACKUP_COUNT=7

# Dev-only: header carrying the instructor user id (preferences, manual PATCH, publish)
DEV_USER_ID_HEADER=X-User-Id
